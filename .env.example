# ============================================================
# kb-backend 部署配置（模板）
# 用法：./deploy.sh 会复制本文件为 .env 并把 __GENERATE__ 替换为随机值。
# 模板不含任何真实凭证 / provider key —— 模型部署后登录「模型管理」自配。
# ============================================================

# === 基础设施凭证（__GENERATE__ 由 deploy.sh 现场生成；改过须连同数据卷一起重建）===
POSTGRES_DB=kb
POSTGRES_USER=kb
POSTGRES_PASSWORD=__GENERATE__
MINIO_ACCESS_KEY=__GENERATE__
MINIO_SECRET_KEY=__GENERATE__
# DATABASE_URL / ES_URL / MINIO_ENDPOINT / REDIS_URL 不在此配 ——
# compose 用服务名（postgres / elasticsearch / minio / redis）自动拼装，容器内可达。

# === 服务身份 ===
KB_API_KEY=__GENERATE__
KB_BACKEND_URL=http://localhost:8000

# === 加密 ===
MODEL_SECRET=__GENERATE__
# ⚠️ Fernet 派生，加密「模型管理」里所有 provider 的 API-key。
#    务必跨重启/迁移保持不变；丢失 = 库里已配置的模型 key 全部作废，需重输。

# === 检索 / 摄取参数（可选，留空用默认）===
STORE_MODE=es
# CHUNK_TOKEN_NUM=512
# MIN_TOKENS_TO_SUMMARIZE=1500
# DEFAULT_TOP_K=8
# PATH_A_THETA=0.2          # 真 embedding 用 0.2；仅 memory / 哈希伪向量时设 -1

# === 前端 CORS（可选；web 经 nginx 同源访问时无需配）===
# CORS_ORIGINS=http://localhost:5173

# === 模型配置 ===
# 推荐：部署后用打印的 KB_API_KEY 登录 → 「模型管理」添加任意渠道
#   （OpenAI / Anthropic / Gemini / 本地 vLLM·BGE / DeepSeek 等），至少一个 embedding + 一个 LLM。
# 可选 env 种子（免登录即生效；渠道无关，填任意 provider）：
#   LLM 按 anthropic 兼容端点、embedding 按 OpenAI 兼容 /embeddings。
# MODEL_API_KEY=
# LLM_BASE_URL=                   # 如 https://api.anthropic.com
# LLM_MODEL=                      # 如 claude-sonnet-4-5
# EMBED_BASE_URL=                 # 如 https://api.openai.com/v1
# EMBED_MODEL=                    # 如 text-embedding-3
# EMBED_DIM=2048
